# /etc/systemd/system/mstd-random-restaurant.timer

[Unit]
Description=Run mstd-random-restaurant every hour
Requires=mstd-random-restaurant.service

[Timer]
#Execute job if it missed a run due to machine being off
Persistent=true
#Run 10 seconds after boot for the first time
OnBootSec=10
#Run every 60 minute thereafter
OnUnitActiveSec=3600
#File describing job to execute
Unit=mstd-random-restaurant.service

[Install]
WantedBy=timers.target
