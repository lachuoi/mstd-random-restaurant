#/etc/systemd/system/mstd-random-cafe.service

[Unit]
Description=Runs mstd-random-cafe container
Requires=docker.service
Wants=mstd-random-cafe.timer

[Service]
#Restart=always
User=root
Group=docker
WorkingDirectory=/apps/mstd-random-cafe
# Shutdown container (if running) when unit is started
ExecStartPre=/usr/bin/docker compose -f docker-compose.yaml create 
# Start container when unit is started
ExecStart=/usr/bin/docker compose -f docker-compose.yaml start
# Stop container when unit is stopped
ExecStop=/usr/bin/docker compose -f docker-compose.yaml stop

[Install]
WantedBy=multi-user.target
