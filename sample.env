# Mastodon Configuration
# The domain of your Mastodon instance (e.g., mastodon.social)
MSTDN_URI=
# Your Mastodon account's access token
MSTDN_ACCESS_TOKEN=

# Google Cloud Configuration
# Your Google Cloud API key with Places API and Gemini API access enabled
GOOGLE_API_KEY=

# (Optional) Separate Gemini API Key if different from GOOGLE_API_KEY
GEMINI_API_KEY=
# (Optional) Custom Gemini API URI
GEMINI_API_KEY_API_URI=

# (Optional) Weighted Selection
# Comma-separated list of ISO2 country codes to weight higher in random selection
# Default: DE,GB,FR,ES,IT,TW,TH,VN,MX,PT,KR
WEIGHTED_COUNTRIES=DE,GB,FR,ES,IT,TW,TH,VN,MX,PT,KR
