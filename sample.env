# Mastodon Instance Configuration
MSTDN_URI=mastodon.social
MSTDN_ACCESS_TOKEN=

# Google Cloud & Gemini API Configuration
# GOOGLE_API_KEY is used for both Places API and Gemini API (if GEMINI_API_KEY is not set)
GOOGLE_API_KEY=

# (Optional) Separate key for Gemini if different from GOOGLE_API_KEY
GEMINI_API_KEY=

# (Optional) Custom API endpoint for Gemini
# GEMINI_API_KEY_API_URI=https://generativelanguage.googleapis.com/v1/models/gemini-1.5-flash:generateContent

# Application Configuration
# List of countries to prioritize for random selection
WEIGHTED_COUNTRIES=US,FR,ES,IT,JP,TW,TH,VN,MX,PT,KR
